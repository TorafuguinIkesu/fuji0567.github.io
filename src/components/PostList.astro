---
import type { BlogPost } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-link" href={`/blog/${post.id}/`}>
          <span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-description">{post.data.description}</span>
          </span>
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </a>
      </li>
    ))}
  </ul>
) : (
  <p class="empty-state">記事はまだありません。</p>
)}
