---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title = 'FUJI 0567',
  description = 'FUJI 0567 の個人ブログ。',
  image = '/og.png',
  type = 'website',
  publishedTime,
} = Astro.props;
const pageTitle = title === 'FUJI 0567' ? title : `${title} | FUJI 0567`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="FUJI 0567 RSS" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="FUJI 0567" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <title>{pageTitle}</title>

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">本文へ移動</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-name" href="/" aria-label="FUJI 0567 ホーム">FUJI 0567</a>
        <nav aria-label="メインナビゲーション">
          <a href="/blog/">Blog</a>
          <a href="/tags/">Tags</a>
          <a href="/about/">About</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="表示テーマを切り替える" title="表示テーマを切り替える">
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <small>© {new Date().getFullYear()} FUJI 0567</small>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f7f7f5;
    --surface: #ffffff;
    --ink: #111111;
    --muted: #6d6d6a;
    --line: #d9d9d4;
    --soft: #ecece7;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --paper: #111111;
    --surface: #181818;
    --ink: #f4f4ef;
    --muted: #ababA4;
    --line: #343430;
    --soft: #252522;
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body {
    min-width: 320px;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.75;
    text-rendering: optimizeLegibility;
  }
  a { color: inherit; text-underline-offset: 0.2em; }
  a:hover { text-decoration-thickness: 2px; }
  button { font: inherit; }
  .container { width: min(100% - 3rem, 1040px); margin-inline: auto; }
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner { min-height: 76px; display: flex; align-items: center; gap: 1.25rem; }
  .site-name { margin-right: auto; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.13em; text-decoration: none; }
  nav { display: flex; gap: 1.15rem; font-size: 0.9rem; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .theme-toggle {
    display: grid; width: 2.25rem; height: 2.25rem; place-items: center;
    padding: 0; border: 1px solid var(--line); border-radius: 999px;
    background: transparent; color: var(--ink); cursor: pointer;
  }
  .theme-toggle:hover { background: var(--soft); }
  .skip-link { position: fixed; top: 0.5rem; left: 0.5rem; z-index: 5; padding: 0.4rem 0.75rem; background: var(--ink); color: var(--paper); transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .site-footer { margin-top: 7rem; border-top: 1px solid var(--line); }
  .footer-inner { display: flex; justify-content: space-between; padding-block: 1.4rem; color: var(--muted); font-size: 0.8rem; }
  .eyebrow { margin: 0 0 1rem; color: var(--muted); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .page-intro { max-width: 680px; padding-top: 5.5rem; }
  .page-intro h1 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 8vw, 6.4rem); font-weight: 600; letter-spacing: -0.075em; line-height: 0.98; }
  .page-intro p:not(.eyebrow) { max-width: 44rem; margin: 1.75rem 0 0; color: var(--muted); }
  .section { margin-top: 5rem; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h2 { margin: 0; font-size: 1rem; letter-spacing: -0.02em; }
  .section-heading a, .text-link { font-size: 0.875rem; }
  .post-list { padding: 0; margin: 0; list-style: none; border-top: 1px solid var(--line); }
  .post-list > li { border-bottom: 1px solid var(--line); }
  .post-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 1.25rem 0; text-decoration: none; }
  .post-link:hover .post-title { text-decoration: underline; }
  .post-title { display: block; font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 600; letter-spacing: -0.025em; }
  .post-description { display: block; margin-top: 0.35rem; color: var(--muted); font-size: 0.9rem; }
  .post-date { color: var(--muted); font-size: 0.8rem; white-space: nowrap; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 1rem 0 0; list-style: none; }
  .tag { display: inline-block; padding: 0.18rem 0.58rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 0.76rem; text-decoration: none; }
  .tag:hover { background: var(--soft); color: var(--ink); }
  .empty-state { padding: 2rem 0; border-block: 1px solid var(--line); color: var(--muted); }
  .article { width: min(100% - 3rem, 720px); margin-inline: auto; padding-top: 5.5rem; }
  .article-header { padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .article-header h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 4.5rem); font-weight: 600; letter-spacing: -0.065em; line-height: 1.04; }
  .article-meta { margin: 1.2rem 0 0; color: var(--muted); font-size: 0.875rem; }
  .prose { padding-top: 2.75rem; font-size: 1.05rem; }
  .prose h2, .prose h3 { margin-top: 3rem; line-height: 1.2; letter-spacing: -0.035em; }
  .prose h2 { font-size: 1.7rem; }
  .prose h3 { font-size: 1.25rem; }
  .prose p, .prose ul, .prose ol { margin-block: 1.25rem; }
  .prose blockquote { margin: 1.5rem 0; padding-left: 1.2rem; border-left: 2px solid var(--ink); color: var(--muted); }
  .prose pre { overflow-x: auto; padding: 1rem; background: var(--surface); border: 1px solid var(--line); }
  .about-copy { max-width: 680px; margin-top: 3rem; padding: 1.5rem 0; border-top: 1px solid var(--line); color: var(--muted); }
  .tag-grid { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 3rem; }
  .tag-grid .tag { font-size: 0.9rem; }
  @media (max-width: 560px) {
    .container, .article { width: min(100% - 2rem, 1040px); }
    .header-inner { min-height: 64px; gap: 0.8rem; }
    nav { gap: 0.75rem; font-size: 0.8rem; }
    .site-name { font-size: 0.8rem; }
    .page-intro, .article { padding-top: 3.75rem; }
    .section { margin-top: 3.5rem; }
    .site-footer { margin-top: 5rem; }
    .post-link { grid-template-columns: 1fr; gap: 0.45rem; }
  }
</style>
